{
  "name": "andon",
  "version": "0.0.9",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-icon": "node build-icon.js",
    "dist": "npm run build-icon && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "tools.andon.app",
    "productName": "Andon",
    "asar": false,
    "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
    "files": [
      "main.js",
      "pulse-icon.js",
      "update-status.js",
      "merge-hooks.js",
      "generate-pluck.js",
      "updater.js",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "zip", "arch": ["arm64", "x64"] },
        { "target": "dmg", "arch": ["arm64"] }
      ]
    }
  }
}